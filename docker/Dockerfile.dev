# syntax=docker/dockerfile:1
# Shared project environment. Built in CI and pulled as
# ghcr.io/startupp-cloud/ide-dev:<version> — see docker/project-image.json.
# Aider and extra agents are optional (install from the IDE shell).

FROM node:20-bookworm AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl wget jq python3 python3-pip \
    build-essential openssh-client \
    nano vim less htop tmux dtach util-linux \
    && rm -rf /var/lib/apt/lists/*

# GitHub CLI
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g pnpm

RUN useradd -m -s /bin/bash dev \
    && mkdir -p /workspace \
    && chown dev:dev /workspace

RUN echo '\
set -g default-terminal "tmux-256color"\n\
set -as terminal-overrides ",xterm*:Tc"\n\
set -g mouse on\n\
set -g history-limit 50000\n\
set -g escape-time 0\n\
set -g focus-events on\n\
set -g status off\n\
set -g allow-passthrough on\n\
set -gq allow-passthrough all\n\
setw -g xterm-keys on\n\
set -g set-clipboard on\n\
' > /home/dev/.tmux.conf && chown dev:dev /home/dev/.tmux.conf

ENV NPM_CONFIG_PREFIX=/home/dev/.npm-global
ENV BROWSER=false
ENV PATH="/home/dev/.npm-global/bin:${PATH}"

USER dev
WORKDIR /home/dev

RUN mkdir -p "$NPM_CONFIG_PREFIX" \
    && npm config set prefix "$NPM_CONFIG_PREFIX"

WORKDIR /workspace

FROM base AS ai
USER root
RUN npm install -g @anthropic-ai/claude-code
USER dev

FROM ai
CMD ["sleep", "infinity"]
